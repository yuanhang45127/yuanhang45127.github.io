---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../Entry.astro';
import { profile } from '../../config';
import { ui, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  alternatePath: string;
}
const { lang, alternatePath } = Astro.props;
const t = ui[lang];
const zh = lang === 'zh';

const entries = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const master = entries.filter((e) => e.data.category === 'master');
const undergrad = entries.filter((e) => e.data.category === 'undergrad');
---

<Base
  lang={lang}
  title={zh ? `科研 · ${profile.nameZh}` : `Research · ${profile.nameEn}`}
  description={zh ? '科研经历：电离层时空预测、点云感知、车路协同环境感知。' : 'Research experience: ionospheric forecasting, point cloud perception, cooperative perception.'}
  active="research"
  {alternatePath}
>
  <main class="page">
    <div class="container">
      <h1 class="page-title">{t['section.research']}</h1>
      <p class="page-desc">
        {zh
          ? '硕士阶段从事电离层时空数据挖掘与预测建模，成果部署于中国气象局业务系统；本科阶段围绕激光雷达点云与轨道交通环境感知展开。'
          : "Master's research on ionospheric spatiotemporal data mining, deployed into operational use at the China Meteorological Administration; undergraduate work on LiDAR point cloud perception for rail transit."}
      </p>

      <p class="phd-strip">{zh ? profile.phdDirectionZh : profile.phdDirectionEn}</p>

      <h2 class="section-label">{zh ? '硕士课题' : "Master's Research"}</h2>
      {master.map((e) => (
        <Entry
          title={zh ? e.data.title : e.data.titleEn}
          period={e.data.period}
          meta={`${zh ? e.data.org : e.data.orgEn} · ${zh ? e.data.role : e.data.roleEn}`}
          highlights={zh ? e.data.highlights : e.data.highlightsEn}
        />
      ))}

      <h2 class="section-label">{zh ? '本科科研' : 'Undergraduate Research'}</h2>
      {undergrad.map((e) => (
        <Entry
          title={zh ? e.data.title : e.data.titleEn}
          period={e.data.period}
          meta={`${zh ? e.data.org : e.data.orgEn} · ${zh ? e.data.role : e.data.roleEn}`}
          highlights={zh ? e.data.highlights : e.data.highlightsEn}
        />
      ))}
    </div>
  </main>
</Base>
